#! /usr/bin/env bash

export PATH="${ASDF_DATA_DIR:-/home/cjpoll/.asdf}/shims:/home/cjpoll/bin/:$PATH"

# gtk4-layer-shell must interpose libwayland-client symbols before GTK
# connects to the compositor; loaded via GObject Introspection it arrives
# too late, so preload it (github.com/wmww/gtk4-layer-shell linking.md).
export LD_PRELOAD=/usr/lib64/libgtk4-layer-shell.so

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$ROOT"
mkdir -p logs
echo "$(ruby --version)" > logs/ruby-version.log

# Hyprland discards exec-once stderr, so keep our own log. Truncated per launch:
# what's worth diagnosing is why this session's bar misbehaved.
exec > logs/bar.log 2>&1
echo "=== started $(date --iso-8601=seconds) ==="

exec bundle exec ruby apps/bar/main.rb "${@}"
