#! /usr/bin/env bash

export PATH="${ASDF_DATA_DIR:-/home/cjpoll/.asdf}/shims:/home/cjpoll/bin/:$PATH"

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$ROOT"
mkdir -p logs

# Resolver progress and warnings land here. Truncated per launch.
exec > logs/portland.log 2>&1
echo "=== started $(date --iso-8601=seconds) ==="

exec bundle exec ruby apps/portland/main.rb "${@}"
